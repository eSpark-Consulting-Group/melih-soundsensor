menu "Hardware type"

choice BOARD_TYPE
   bool "Type of board"
   default BOARD_TYPE_DEVCITV4
   help
       Specify how much output to see in bootloader logs.

config BOARD_TYPE_DEVCITV4
   bool "ESP32-DevKitC V4"
config BOARD_TYPE_ATOM
   bool "ATOM32"
config BOARD_TYPE_PLUG_HUB
   bool "Plug hub"
config BOARD_TYPE_WATER_VALVE
   bool "Water valve"

endchoice

config BOARD_TYPE
    int
    default 0 if BOARD_TYPE_DEVCITV4
    default 1 if BOARD_TYPE_ATOM
    default 2 if BOARD_TYPE_PLUG_HUB
    default 3 if BOARD_TYPE_WATER_VALVE

endmenu

menu "REVISION"
config SPIRAM
    bool "Enable revision 2"
    default false
config METER_CHIP_STPM
    bool "TRUE if meter chip STPM32 else false"
    default false
config LED_ACTIVE_LEVEL
    int "Led active level (0 or 1)"
    range 0 1
    default 0
config UART_API
    bool "Enable UART API"
    default false
endmenu

menu "Hardware Flags"
config IS_LOW_MEMORY_DEVICE
    bool "Compilation flag for devices with low memory capacity (Atom rev1, plug hub rev1)"
    default false
endmenu

menu "Feature Flags"
config LOCAL_MODE
    bool "Enable compilation of local mode"
    default "y" if SPIRAM
    help
        Define whether the source code of local mode implementation is included at compile time.
config CLOUD_DEVICES
    bool "Enable compilation of cloud devices"
    default "n"
    help
        Define whether the source code of cloud devices implementation is included at compile time.
config ADVANCED_SCENES
    bool "Enable compilation of advanced scenes"
    default "y"
    help
        Define whether the source code of advanced scenes implementation is included at compile time.
endmenu

menu "Log level"
config REMOTE_LOGGING
    bool "Enable remote logging"
    default false
config REMOTE_LOGLEVEL
    int "Remote log level (0-6: ALL, TRACE, DEBUG, INFO, WARNING, ERROR, NONE)"
    range 0 6
    default 6
config PROD_ESP_LOG_LEVEL
    int "ESP log level for production builds (0-5: NONE, ERROR, WARN, INFO, DEBUG, VERBOSE)"
    range 0 5
    default 3
config DEV_ESP_LOG_LEVEL
    int "Default ESP log level for regular dev builds (0-5: NONE, ERROR, WARN, INFO, DEBUG, VERBOSE)"
    range 0 5
    default 4
endmenu


