menu "Little FS Configuration"

    config ESP_VFS_LITTLEFS_MAX_PARTITIONS
        int "Maximum Number of Partitions"
        default 2
        range 1 4
        help
            Define maximum number of partitions that can be mounted.

    config ESP_VFS_LITTLEFS_MAX_FILES
        int "Maximum number of simultaneously opened files"
        default 8
        range 1 64
        help
            Define maximum number of files that can be opened at the same time.


    config ESP_LITTLEFS_READ_BUF_SIZE
        int "Minimum size of a block read"
        default 128
        range 32 4096
        help
            Minimum size of a block read. All read operations will be a
            multiple of this value.

    config ESP_LITTLEFS_PROG_BUF_SIZE
        int "Minimum size of a block program"
        default 128
        range 32 4096
        help
            Minimum size of a block program. All program operations will be a
            multiple of this value.

    config ESP_LITTLEFS_LOOKAHEAD_BUF_SIZE
        int "Size of the lookahead buffer in bytes"
        default 16
        range 32 4096
        help
            Size of the lookahead buffer in bytes. A larger lookahead buffer
            increases the number of blocks found during an allocation pass. The
            lookahead buffer is stored as a compact bitmap, so each byte of RAM
            can track 8 blocks. Must be a multiple of 4.

    config ESP_LITTLEFS_CACHE_SIZE
        int "Size of block caches"
        default 128
        range 32 4096
        help
            Size of block caches. Each cache buffers a portion of a block in RAM.
            The littlefs needs a read cache, a program cache, and one additional
            cache per file. Larger caches can improve performance by storing more
            the read and program sizes, and a factor of the block size.

    config ESP_LITTLEFS_PAGE_SIZE
        int "LittleFs logical page size"
        default 4096
        range 4096 32768
        help
            Logical page size of LittleFs partition, in bytes. Must be multiple
            of flash page size (which is usually 256 bytes).
            Larger page sizes reduce overhead when storing large files, and
            improve filesystem performance when reading large files.
            Smaller page sizes reduce overhead when storing small (< page size)
            files.

    config ESP_LITTLEFS_MALLOC
        bool "Enable LittleFs malloc"
        default "n"
        help
            Enabling this option will enable malloc for LittleFs.

    config ESP_LITTLEFS_INTRINSICS
        bool "Enable LittleFs intrinsics"
        default "y"
        help
            Enabling this option will disable LittleFs intrinsics.

    menu "Debug Configuration"

        config ESP_LITTLEFS_LOG_DEBUG
            bool "Enable Littlefs debug messages"
            default "y"
            help
                Enabling this option will print debug mesages to the console.

        config ESP_LITTLEFS_LOG_WARN
            bool "Enable LittleFs warning messages"
            default "y"
            help
                Enabling this option will print warning mesages to the console.

        config ESP_LITTLEFS_LOG_ERROR
            bool "Enable LittleFs error messages"
            default "y"
            help
                Enabling this option will print error mesages to the console.

        config ESP_LITTLEFS_ASSERT
            bool "Enable LittleFs assert"
            default "y"
            help
                Enabling this option will enable assert for LittleFs.
    endmenu

endmenu
